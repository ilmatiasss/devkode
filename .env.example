# Variables de entorno del sitio. En Vercel van en Settings → Environment Variables.
# Para usarlas en tu computador, copia este archivo como .env.local (no se sube a git).

# Formulario de cotización y avisos del panel (correo de Google Workspace, servidor smtp.gmail.com)
# SMTP_PASS es una "contraseña de aplicación" de Google (requiere verificación en dos pasos), no la contraseña normal.
SMTP_USER=contacto@devkode.cl
SMTP_PASS=

# Panel de administración (/admin)
# Cadena de conexión "pooled" de Neon (Dashboard → Connect → Pooled connection)
DATABASE_URL=
# Código para la configuración inicial (/admin/configurar). Mínimo 24 caracteres.
# Bórralo de Vercel apenas crees las cuentas.
ADMIN_SETUP_TOKEN=
# Secreto para la revisión diaria de cobros (Vercel Cron). Mínimo 16 caracteres.
CRON_SECRET=
